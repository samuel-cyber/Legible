<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · Legible</title>
<style>
  :root {
    --bg:#faf8f3; --panel:#ffffff; --ink:#1a1816; --muted:#5c574e; --rule:#e3ddd0;
    --accent:#0d5c5c;
    --ok:#1c6b3a; --ok-bg:#dcefe2; --fix:#8a5a00; --fix-bg:#f6ecd2;
    --stop:#9b2226; --stop-bg:#f5dcdc; --ai:#3d5a8c; --ai-bg:#e3e8f3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#15181a; --panel:#1c2023; --ink:#ecebe6; --muted:#a8a59c; --rule:#32383c;
      --accent:#6fd0d0;
      --ok:#6fcf97; --ok-bg:#1c3326; --fix:#f2b54b; --fix-bg:#3a2e14;
      --stop:#ff8a80; --stop-bg:#3a1f1f; --ai:#9db4e0; --ai-bg:#1f2838;
    }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font: 19px/1.7 Georgia, "Iowan Old Style", serif; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .skip { position:absolute; left:-999px; } .skip:focus { left:16px; top:16px; z-index:10; background:var(--ink); color:var(--bg); padding:10px 14px; border-radius:8px; }
  main { max-width: 720px; margin: 0 auto; padding: 56px 24px 110px; }
  header p { color:var(--muted); font: 16px/1.55 system-ui, sans-serif; margin: 8px 0 0; }
  h1 { font-size: 2.1rem; line-height:1.2; margin: 0; }
  h2 { font-size: 1.4rem; margin: 2.3em 0 .5em; } h3 { font-size: 1.1rem; margin: 1.8em 0 .3em; }
  .eq { margin: 1.7em 0; padding: 20px 22px; border: 1px solid var(--rule); background: var(--panel);
        border-radius: 12px; border-left: 4px solid var(--ok); }
  .eq.repaired { border-left-color: var(--fix); } .eq.withheld { border-left-color: var(--stop); } .eq.ai_read { border-left-color: var(--ai); }
  .eq math { font-size: 1.2em; }
  .status { display:inline-flex; align-items:center; font: 700 12.5px/1 system-ui, sans-serif;
            letter-spacing:.02em; margin: 14px 0 0; padding: .4em .75em; border-radius:999px;
            background: var(--ok-bg); color: var(--ok); }
  .repaired .status { background: var(--fix-bg); color: var(--fix); }
  .withheld .status { background: var(--stop-bg); color: var(--stop); }
  .ai_read .status { background: var(--ai-bg); color: var(--ai); }
  .raw { font-family: ui-monospace, monospace; font-size: .85em; }
  .page-note { margin: 2em 0 1.4em; padding: 14px 20px; border: 2px dashed var(--ai);
               background: var(--ai-bg); color: var(--ai); border-radius: 10px;
               font: 600 15px/1.5 system-ui, sans-serif; }
  .page-note::before { content: "⚠ "; }
  dl.glossary { display:grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 14px 0 0; font: 16px/1.55 system-ui, sans-serif; }
  dl.glossary dt { font-style: italic; font-family: Georgia, serif; font-weight:700; } dl.glossary dd { margin: 0; color: var(--muted); }
  .glossary-label { font: 700 12.5px/1 system-ui, sans-serif; letter-spacing:.03em; text-transform:uppercase; margin: 16px 0 6px; color: var(--muted); }
  footer { margin-top: 72px; padding-top: 20px; border-top: 1px solid var(--rule); color: var(--muted); font: 14px/1.6 system-ui, sans-serif; }
  a { color: var(--accent); }
  .ask { margin: 18px 0 0; padding-top: 16px; border-top: 1px dashed var(--rule); font: 16px/1.5 system-ui, sans-serif; }
  .ask label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  .ask-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .ask-input { flex: 1 1 14rem; font: inherit; font-size:15px; padding: 8px 11px; border: 1px solid var(--rule); border-radius: 8px;
               background: var(--bg); color: var(--ink); }
  .ask-button { font: 700 14px system-ui, sans-serif; padding: 8px 16px; border: 1.5px solid var(--accent);
                border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; }
  .ask-answer { margin: 10px 0 0; min-height: 1.4em; font-size: 15.5px; }
  .ask-answer ol { margin: 6px 0 0; padding-left: 20px; }
</style>
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<main id="content">
  <header>
    <h1>{{ title }}</h1>
    <p>{{ summary.total }} equations: {{ summary.verified }} verified, {{ summary.repaired }} repaired{% if summary.ai_read %}, {{ summary.ai_read }} AI-read (not independently verified){% endif %}, {{ summary.withheld }} not verified.</p>
  </header>
  {% for b in blocks %}
    {% if b.kind == "heading" %}
      <h{{ b.level }}>{{ b.text }}</h{{ b.level }}>
    {% elif b.kind == "page_note" %}
      <p class="page-note">{{ b.text }}</p>
    {% elif b.kind == "para" %}
      <p>{{ b.text }}</p>
    {% elif b.kind == "equation" %}
      {% set r = results[b.eq_id] %}
      <div class="eq {{ r.status }}" role="group" aria-label="Equation {{ loop_index[b.eq_id] }}">
        {% if r.status in ["verified", "repaired"] %}
          {{ mathml[b.eq_id] | safe }}
          <p class="status">{% if r.status == "verified" %}Verified against the PDF{% else %}Corrected and verified{% endif %}</p>
        {% elif r.status == "ai_read" %}
          {{ mathml[b.eq_id] | safe }}
          <p class="status">AI reading, not independently verified against the source{% if r.cautions %} — a check flagged something here{% endif %}</p>
        {% else %}
          <p><strong>Unverified equation.</strong> Legible could not confirm this equation, so it is not read as math. Text found in the PDF, unverified: <span class="raw">{{ r.raw_text }}</span></p>
          <p class="status">Not verified: check with your lecturer or a sighted helper</p>
        {% endif %}
        {% if b.glossary %}
          <p class="glossary-label" id="gl-{{ b.eq_id }}">Where, quoted from the notes:</p>
          <dl class="glossary" aria-labelledby="gl-{{ b.eq_id }}">
            {% for sym, meaning in b.glossary %}<dt>{{ sym }}</dt><dd>{{ meaning }}</dd>{% endfor %}
          </dl>
        {% endif %}
        {% if b.eq_id in facts %}
          <div class="ask" data-eq="{{ b.eq_id }}">
            <script type="application/json" class="ask-facts">{{ facts[b.eq_id] | safe }}</script>
            <label for="ask-input-{{ b.eq_id }}">Ask about this equation (structure only, no AI)</label>
            <div class="ask-row">
              <input type="text" id="ask-input-{{ b.eq_id }}" class="ask-input"
                     placeholder="e.g. what's in the numerator?">
              <button type="button" class="ask-button">Ask</button>
            </div>
            <div class="ask-answer" role="status" aria-live="polite"></div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
  <footer>Made accessible by Legible. Every equation shown as math was checked against the original PDF. <a href="{{ report_href }}">Verification report</a></footer>
</main>
<script>
(function () {
  "use strict";
  var REFUSAL = "I can only answer questions about this equation's structure.";

  function stripPunct(s) { return s.replace(/^[?.,!'"]+|[?.,!'"]+$/g, ""); }

  function listFractions(fractions, key) {
    if (!fractions.length) return "There's no fraction in this equation.";
    if (fractions.length === 1) {
      return "The " + (key === "num" ? "numerator" : "denominator") + " is: " + fractions[0][key];
    }
    var lines = fractions.map(function (f, i) { return "Fraction " + (i + 1) + ": " + f[key] + "."; });
    return "This equation has " + fractions.length + " fractions. " + lines.join(" ");
  }

  function scriptAnswer(facts, sym, role, word, article) {
    var entry = facts.scripts[sym];
    if (!entry) return "'" + sym + "' doesn't appear in this equation.";
    var val = entry[role];
    if (!val) return "'" + sym + "' doesn't have " + article + " " + word + " here.";
    return "The " + word + " of '" + sym + "' is: " + val;
  }

  function insideBrackets(brackets) {
    if (!brackets.length) return "There are no brackets in this equation.";
    if (brackets.length === 1) return "Inside the brackets: " + brackets[0];
    var lines = brackets.map(function (b, i) { return "Bracket " + (i + 1) + ": " + b; });
    return "This equation has " + brackets.length + " bracketed groups. " + lines.join(" ");
  }

  function bracketAfter(facts, sym) {
    return facts.bracket_after[sym] || ("'" + sym + "' doesn't appear in this equation.");
  }

  function glossaryAnswer(glossary, sym) {
    var hit = glossary[sym.toLowerCase()];
    return hit ? ("'" + sym + "' is " + hit) : "The notes don't say.";
  }

  // Mirrors equations/ask.py's question categories; the structural facts
  // themselves (fractions, scripts, brackets, spoken_parts, glossary) are
  // computed once in Python and embedded as JSON, never re-derived here.
  function answerQuestion(facts, question) {
    var q = (question || "").trim();
    if (!q) return { text: REFUSAL };
    var m;
    if (/\bnumerator\b/i.test(q)) return { text: listFractions(facts.fractions, "num") };
    if (/\bdenominator\b/i.test(q)) return { text: listFractions(facts.fractions, "den") };
    if ((m = q.match(/\bexponent\b.*?\bof\b\s+(\S+)/i))) {
      return { text: scriptAnswer(facts, stripPunct(m[1]), "sup", "exponent", "an") };
    }
    if ((m = q.match(/\bsubscript\b.*?\bof\b\s+(\S+)/i))) {
      return { text: scriptAnswer(facts, stripPunct(m[1]), "sub", "subscript", "a") };
    }
    if ((m = q.match(/\bwhich\s+bracket\b.*?\bafter\b\s+(\S+)/i))) {
      return { text: bracketAfter(facts, stripPunct(m[1])) };
    }
    if ((m = q.match(/\bclos(?:es|e)\s+after\b\s+(\S+)/i))) {
      return { text: bracketAfter(facts, stripPunct(m[1])) };
    }
    if (/\binside\b.*?\bbracket/i.test(q)) return { text: insideBrackets(facts.brackets) };
    if (/\bread\b.*?\bslow/i.test(q)) {
      return { text: "Reading it slowly, one part at a time.", parts: facts.spoken_parts };
    }
    if ((m = q.match(/\bwhat\s+does\b\s+(\S+)\s+mean\b/i))) {
      return { text: glossaryAnswer(facts.glossary, stripPunct(m[1])) };
    }
    if ((m = q.match(/\bmeaning\s+of\b\s+(\S+)/i))) {
      return { text: glossaryAnswer(facts.glossary, stripPunct(m[1])) };
    }
    return { text: REFUSAL };
  }

  var boxes = document.querySelectorAll(".ask");
  boxes.forEach(function (box) {
    var facts = JSON.parse(box.querySelector(".ask-facts").textContent);
    var input = box.querySelector(".ask-input");
    var button = box.querySelector(".ask-button");
    var answerBox = box.querySelector(".ask-answer");

    function run() {
      var result = answerQuestion(facts, input.value);
      answerBox.innerHTML = "";
      answerBox.appendChild(document.createTextNode(result.text));
      if (result.parts) {
        var ol = document.createElement("ol");
        result.parts.forEach(function (p) {
          var li = document.createElement("li");
          li.textContent = p;
          ol.appendChild(li);
        });
        answerBox.appendChild(ol);
      }
    }

    button.addEventListener("click", run);
    input.addEventListener("keydown", function (e) {
      if (e.key === "Enter") { e.preventDefault(); run(); }
    });
  });
})();
</script>
</body>
</html>
